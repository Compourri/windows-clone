{
  "schemaVersion": 1,
  "id": "com.compourri.windows-clone",
  "name": "Windows Clone",
  "version": "1.0.3",
  "author": "Compourri",
  "description": "Clone whole Windows disk (EFI+MSR+NTFS+Recovery) with mismatched sizes - GUI for clone-windows.sh",
  "kinds": ["overlay", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Clone.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Windows Clone",
    "description": "Clone client Windows drives",
    "category": "System",
    "allowMultiple": false,
    "defaults": {}
  }
}
